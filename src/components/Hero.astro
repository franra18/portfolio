---
import { ui, asset, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const stack = ['Java', 'Spring Boot', 'Spring AI', 'Python', 'FastAPI', 'React Native', 'Vue 3', 'MCP', 'Gen AI', 'Docker', 'Kubernetes', 'PostgreSQL'];
---
<section class="hero wrap f-dark grid min-h-[calc(100svh-68px)] grid-cols-[1fr] grid-rows-[auto_auto_auto] gap-x-m gap-y-10 pb-[clamp(24px,4vw,56px)] lg:grid-cols-[minmax(0,1fr)_minmax(260px,30%)] lg:grid-rows-[1fr_auto] lg:gap-y-0" id="inicio" aria-label={t['hero.label']}>
  <div class="self-center pt-[10vh] lg:pt-[4vh]">
    <h1 id="hero-name" class="origin-left text-[17.5vw] font-bold leading-[.84] tracking-[-0.04em] sm:text-[15vw] lg:text-[min(12.5vw,13rem)]">
      <span class="block animate-up">Francisco</span><span class="block animate-up text-accent-on-dark [animation-delay:.12s]">Ramírez</span>
    </h1>
    <p class="rise mt-7 text-title font-semibold leading-[1.15] tracking-[-0.02em]" style="--i:1">
      <span>{t['hero.build']}</span> <span class="inline-block text-accent-on-dark transition-[opacity,translate] duration-350 ease-soft [&.out]:-translate-y-[.35em] [&.out]:opacity-0" id="rot" data-words={JSON.stringify(t.rot)}>{t.rot[0]}</span>
    </p>
  </div>
  <figure class="group/photo rise relative m-0 self-center overflow-hidden rounded-[22px] max-lg:order-3 max-lg:max-w-[420px]" style="--i:2">
    <img class="aspect-[5/4] h-auto w-full animate-drift object-cover object-[58%_50%] grayscale contrast-105 transition-[filter] duration-500 group-hover/photo:filter-none lg:aspect-[4/5]" src={asset('img/foto-perfil.webp')} width="2000" height="1078" alt="Francisco Ramírez Cañadas">
    <figcaption class="absolute bottom-3.5 left-3.5 inline-flex items-center gap-2 rounded-full bg-black px-3.5 py-[9px] text-small text-paper tabular-nums">
      <i class="size-[9px] rounded-full bg-accent-on-dark" aria-hidden="true"></i><span>{t['hero.status']}</span> · Málaga <time id="clock"></time>
    </figcaption>
  </figure>
  <div class="col-span-full flex flex-wrap items-end justify-between gap-8">
    <div class="rise flex flex-wrap items-center gap-6" style="--i:1">
      <a class="cv inline-flex min-h-14 items-center justify-center gap-2.5 rounded-full bg-accent px-7 text-body leading-[normal] font-semibold text-pure no-underline transition duration-200 ease-soft hover:-translate-y-[3px] hover:bg-accent-hover active:scale-[.97] max-sm:w-full" href={asset(t.cv)} target="_blank" rel="noopener"><span>{t['hero.cta']}</span> <span aria-hidden="true">↗</span></a>
      <a class="font-semibold decoration-2 underline-offset-[5px] transition-colors duration-200 hover:text-accent-on-dark" href="#contacto">{t['hero.alt']}</a>
    </div>
  </div>
</section>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The line under the name swaps what he builds.
  const rot = document.getElementById('rot')!;
  const words: string[] = JSON.parse(rot.dataset.words!);
  let rotI = 0;
  if (!reduced) setInterval(() => {
    rot.classList.add('out');
    setTimeout(() => { rotI = (rotI + 1) % words.length; rot.textContent = words[rotI]; rot.classList.remove('out'); }, 350);
  }, 2600);

  // Local time in Málaga, whatever the visitor's timezone.
  const clock = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });
  const tick = () => { clock.textContent = fmt.format(new Date()); };
  tick(); setInterval(tick, 30000);

  // Depth on scroll: the name recedes in place (scale + fade) so it never slides into the text below it.
  if (!reduced) {
    const name = document.getElementById('hero-name')!;
    let pending = false;
    const frame = () => {
      pending = false;
      const y = scrollY, vh = innerHeight;
      if (y < vh * 1.2) { const k = Math.min(y / vh, 1); name.style.scale = (1 - k * 0.1).toFixed(3); name.style.opacity = (1 - k * 0.6).toFixed(2); }
    };
    const queue = () => { if (!pending) { pending = true; requestAnimationFrame(frame); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    frame();
  }
</script>

<div class="overflow-hidden bg-[#e4e2dc] py-3.5 text-black" aria-hidden="true">
  <div class="flex w-max animate-tick">
    {[...stack, ...stack].map((s) => (
      <span class="whitespace-nowrap pr-[1.4em] text-lead font-bold tracking-[-0.01em] after:pl-[1.4em] after:opacity-50 after:content-['/']">{s}</span>
    ))}
  </div>
</div>
