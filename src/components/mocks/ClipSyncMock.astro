---
// ClipSync interface fragment, after the real app
const label = 'block text-[11px] font-semibold text-[#d4d4da]';
const input = 'mt-1.5 block overflow-hidden rounded-md border border-[#26262b] bg-[#09090b] px-2.5 py-2 text-ellipsis whitespace-nowrap';
---
<div class="w-full max-w-[620px] min-w-0 rounded-[14px] border border-[#26262b] bg-[#0c0c0e] px-5 pt-[22px] pb-5 text-[12px] leading-[1.3] text-[#e6e6ea]" role="img" aria-label="Interfaz de ClipSync: enlace de YouTube, tiempos de inicio y fin y vista previa del clip vertical">
  <div class="mb-4 text-center"><strong class="block text-[26px] font-semibold tracking-[-0.02em]">ClipSync</strong><span class="mt-1 block text-[#9b9ba3]">Genera recortes verticales en formato 9:16 desde enlaces de YouTube o Twitch.</span></div>
  <div class="grid grid-cols-[1fr] items-start gap-3 sm:grid-cols-[1.55fr_1fr]">
    <div class="min-w-0 rounded-[10px] border border-[#26262b] bg-[#131316] p-3.5">
      <span class={label}>Enlace del vídeo</span>
      <span class={input}>https://www.youtube.com/watch?v=zQyrhjEAqLs</span>
      <div class="mt-3 grid grid-cols-[1fr_1fr] gap-2.5">
        <div><span class={label}>Tiempo inicio</span><span class:list={[input, 'text-center tabular-nums']}>50:00</span></div>
        <div><span class={label}>Tiempo fin</span><span class:list={[input, 'text-center tabular-nums']}>50:20</span></div>
      </div>
      <span class="mt-3.5 flex items-center justify-center gap-2 rounded-md bg-[#e8e8ec] p-[9px] font-semibold text-[#111]"><i class="h-0 w-0 border-y-[5px] border-l-8 border-y-transparent border-l-[#111]"></i>Generar clip</span>
    </div>
    <div class="grid min-w-0 gap-2.5 rounded-[10px] border border-[#26262b] bg-[#131316] p-3.5">
      <div class="relative mx-auto grid aspect-[9/16] w-[52%] grid-rows-[38%_1fr] overflow-hidden rounded-md bg-[#1b1b1f] sm:w-[74%]">
        <div class="relative flex items-end justify-center overflow-hidden bg-[#3b3a40] pb-1.5 before:absolute before:inset-x-[20%] before:-bottom-[14%] before:h-[42%] before:rounded-[50%_50%_0_0] before:bg-[#222226]">
          <i class="absolute top-[14%] left-1/2 aspect-square w-[30%] -translate-x-1/2 rounded-full bg-[#caa48b]"></i><b class="relative text-[11px] text-[#ffe94d] [text-shadow:0_1px_2px_#000]">la respuesta</b>
        </div>
        <div class="grid content-start gap-[5px] bg-[#f1f2f4] p-2 [&>i]:h-1 [&>i]:rounded-[2px] [&>i]:bg-[#c8cbd2] [&>i:first-child]:h-[7px] [&>i:first-child]:bg-[#2f6fd8] [&>i:nth-child(3n)]:w-[70%] [&>i:nth-child(4n)]:w-[85%]"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-[#141418] px-2 py-[7px]"><i class="h-[9px] w-[7px] border-x-[2.5px] border-x-pure"></i><span class="h-[3px] flex-1 rounded-[2px] bg-[#4a4a52]"><i class="block h-full w-[32%] rounded-[2px] bg-pure"></i></span></div>
      </div>
      <span class="flex items-center justify-center gap-1.5 rounded-md border border-[#2c2c33] bg-[#18181c] p-[7px] font-semibold"><i class="size-2 -translate-y-0.5 rotate-45 border-r-2 border-b-2 border-current"></i>Descargar archivo</span>
    </div>
  </div>
</div>
