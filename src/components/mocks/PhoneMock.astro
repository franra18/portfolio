---
const clothes = [['Chaqueta', '#2c3e57'], ['Pantalón', '#7a6a4e'], ['Jersey', '#6d2f2a'], ['Camisa', '#3d4a3a']];
---
<div class="flex aspect-[9/18.5] w-[min(200px,60%)] flex-col gap-3.5 rounded-[36px] border-[10px] border-[#2c2c2c] bg-paper px-4 py-[22px] text-[13px] text-[#111]">
  <strong class="text-[18px]">Mi armario</strong>
  <div class="grid flex-1 grid-cols-[1fr_1fr] gap-2">
    {clothes.map(([name, bg]) => <div class="flex items-end rounded-lg p-2 font-semibold text-pure" style={`background:${bg}`}>{name}</div>)}
  </div>
  <div class="rounded-lg bg-[#111] px-3 py-2.5 text-pure">Gemini: «Para 18 °C, chaqueta azul con pantalón beige.»</div>
</div>
